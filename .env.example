# rextor-audit agent — copy to `.env` (the real `.env` is a symlink into the
# secret store and is NEVER committed or printed). Values below are placeholders.

# GitHub (PR diff + comment access; webhook HMAC)
GITHUB_TOKEN=
GITHUB_APP_SECRET=

# GitHub App check-runs + reconciliation JWT (F5). All three set → check-runs
# post via the App installation token (kills the PAT dependency); any missing
# → check-runs degrade to the PAT path. Reconcile needs only APP_ID + PEM_PATH.
REXTOR_GITHUB_APP_ID=
REXTOR_GITHUB_INSTALLATION_ID=
REXTOR_GITHUB_APP_PEM_PATH=

# LLM triage (OpenRouter, temp 0). All three unset → triage skipped
# (soft-incomplete); a partial set is a misconfiguration and is warned about.
OPENROUTER_API_KEY=
REXTOR_TRIAGE_MODEL=
REXTOR_FRONTIER_MODEL=

# Chain selection (SPEC-5 registry key; default tempo).
REXTOR_DEFAULT_CHAIN=tempo
# Fork RPC for SPEC-3 sim; unset → sim skipped.
REXTOR_FORK_RPC_URL=
REXTOR_FORK_BLOCK=

# On-chain attestation (SPEC-4 §3). Both unset → "attestation not configured".
REXTOR_AGENT_PRIVATE_KEY=
REXTOR_ATTEST_CONTRACT_ADDRESS=

# ERC-8004 reputation feedback (R2). Everything gated behind
# REXTOR_AUTO_FEEDBACK=on (default OFF — the broadcast is a MAINNET spend, a
# 🔴 RECTOR gate). Registry addresses are env-only, never hardcoded
# (canonical deployments: docs/deployments/erc8004.md).
REXTOR_AUTO_FEEDBACK=
ERC8004_REPUTATION_REGISTRY=
ERC8004_IDENTITY_REGISTRY=
REXTOR_FEEDBACK_RPC_URL=
ERC8004_AGENT_ID=50891
ERC8004_FEEDBACK_VALUE=95
ERC8004_FEEDBACK_DECIMALS=0
REXTOR_FEEDBACK_ENDPOINT=https://www.rextoraudit.com

# Native Solana verdict (SPEC-8 §5). Anchor-shaped reviews mirror their settled
# verdict to the devnet program. Both unset → visible skip note in the PR
# footer. Keypair = the FUNDED agent wallet (JSON array from solana-keygen),
# NOT the program keypair. Smoke: pnpm --filter @rextor/agent solana:smoke.
REXTOR_SOLANA_PROGRAM_ID=
REXTOR_SOLANA_KEYPAIR=

# IPFS pinning (SPEC-4 v2, B3). Pinata JWT for POST /pinning/pinFileToIPFS
# (raw canonical bytes; NOT pinJSONToIPFS — see packages/agent/src/ipfs.ts).
# Unset → the review attests with findingsURI "" — the pin degrades, never blocks.
IPFS_PINNING_JWT=

# Review experience (SPEC-7). rextor.yaml is read from the PR BASE branch —
# no env here. Chat (D5): replies are deterministic templates over the cached
# review; the bot never replies to itself and never takes instructions from
# comments.
REXTOR_BOT_LOGIN=rextor-audit[bot]
REXTOR_CHAT_RATE_LIMIT_PER_HOUR=5

# Review index + repo memory (SPEC-6 §3 / SPEC-7 §4). Unset → no index and
# no dismissals/learnings memory (yaml dismissals still gate reviews).
REXTOR_DB_PATH=

# Server
PORT=8080
# Bearer token for GET /reviews/:owner/:repo (dashboard ↔ agent index).
# Unset → every /reviews request is answered 401 (fail closed).
REXTOR_AGENT_TOKEN=
# Hard deadline (ms) for every GitHub-io stage incl. the chat reply path
# (undici connect-phase hangs evade Octokit's request.timeout). Default 30000.
REXTOR_GITHUB_STAGE_BUDGET_MS=
# Max queued-not-started reviews before the webhook answers 503 +
# Retry-After (boot reconcile re-drives refused deliveries). Default 25.
REXTOR_MAX_PENDING_REVIEWS=
# Graceful-drain cap (ms) on SIGTERM/SIGINT. 0/negative/non-numeric → the
# 900000 default (a 0 cap would exit 1 on the first signal, killing in-flight
# reviews post-ACK).
REXTOR_DRAIN_TIMEOUT_MS=900000
# Boot-time delivery reconciliation (C1): lists the app webhook's recent
# deliveries with the App JWT and re-drives FAILED ones — GitHub never
# auto-redelivers, so this (not GitHub retry behavior) is what makes the
# mid-drain 503 mark-failed contract safe. Default on; set `off` for zero
# startup API calls. Needs the App-JWT half of the F5 triple
# (REXTOR_GITHUB_APP_ID + REXTOR_GITHUB_APP_PEM_PATH; no installation id) —
# unset → a named skip at boot, never a crash.
REXTOR_RECONCILE_DELIVERIES=on
