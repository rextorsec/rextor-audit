# rextor-audit agent — copy to `.env` (the real `.env` is a symlink into the
# secret store and is NEVER committed or printed). Values below are placeholders.

# GitHub (PR diff + comment access; webhook HMAC)
GITHUB_TOKEN=
GITHUB_APP_SECRET=

# LLM triage (OpenRouter, temp 0). All three unset → triage skipped
# (soft-incomplete); a partial set is a misconfiguration and is warned about.
OPENROUTER_API_KEY=
REXTOR_TRIAGE_MODEL=
REXTOR_FRONTIER_MODEL=

# Chain selection (SPEC-5 registry key; default tempo).
REXTOR_DEFAULT_CHAIN=tempo
# Fork RPC for SPEC-3 sim; unset → sim skipped.
REXTOR_FORK_RPC_URL=
REXTOR_FORK_BLOCK=

# On-chain attestation (SPEC-4 §3). Both unset → "attestation not configured".
REXTOR_AGENT_PRIVATE_KEY=
REXTOR_ATTEST_CONTRACT_ADDRESS=

# Native Solana verdict (SPEC-8 §5). Anchor-shaped reviews mirror their settled
# verdict to the devnet program. Both unset → visible skip note in the PR
# footer. Keypair = the FUNDED agent wallet (JSON array from solana-keygen),
# NOT the program keypair. Smoke: pnpm --filter @rextor/agent solana:smoke.
REXTOR_SOLANA_PROGRAM_ID=
REXTOR_SOLANA_KEYPAIR=

# IPFS pinning (SPEC-4 v2, B3). Pinata JWT for POST /pinning/pinFileToIPFS
# (raw canonical bytes; NOT pinJSONToIPFS — see packages/agent/src/ipfs.ts).
# Unset → the review attests with findingsURI "" — the pin degrades, never blocks.
IPFS_PINNING_JWT=

# Review experience (SPEC-7). rextor.yaml is read from the PR BASE branch —
# no env here. Chat (D5): replies are deterministic templates over the cached
# review; the bot never replies to itself and never takes instructions from
# comments.
REXTOR_BOT_LOGIN=rextor-audit[bot]
REXTOR_CHAT_RATE_LIMIT_PER_HOUR=5

# Review index + repo memory (SPEC-6 §3 / SPEC-7 §4). Unset → no index and
# no dismissals/learnings memory (yaml dismissals still gate reviews).
REXTOR_DB_PATH=

# Server
PORT=8080
