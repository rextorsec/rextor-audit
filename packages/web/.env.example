# packages/web — dashboard + landing. Copy values into the Vercel project env
# (or a local `.env.local`, gitignored). All of it is server-side: the token
# never reaches the browser (SPEC-6 invariants 18/19).

# Agent service base URL (no trailing slash) and the SAME token the agent
# expects on GET /reviews/:owner/:repo (agent-side REXTOR_AGENT_TOKEN).
# Unset/mismatched → the dashboard shows its honest "index unavailable" panel.
REXTOR_AGENT_URL=
REXTOR_AGENT_TOKEN=
