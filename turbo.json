{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["REXTOR_SKIP_CONTRACT_TESTS", "REXTOR_CONTRACT_TMPDIR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:run": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
